# --- amoCRM (не нужно в --demo) ---
# Поддомен аккаунта: <subdomain>.amocrm.ru
AMOCRM_SUBDOMAIN=mycompany
# Долгосрочный токен частной интеграции (Настройки → Интеграции → Создать интеграцию → Ключи и доступы).
# Интеграцию создаёт администратор: метод /users (имена менеджеров) доступен только с его правами.
AMOCRM_TOKEN=
# amocrm.ru для российских аккаунтов, kommo.com для международных
AMOCRM_DOMAIN=amocrm.ru

# --- LLM (без ключа система работает в офлайн-режиме на эвристиках) ---
ANTHROPIC_API_KEY=
# Свой прокси/реселлер, если прямой доступ недоступен
ANTHROPIC_BASE_URL=
# Модель для массовой оценки звонков и разбора запроса
LLM_MODEL_FAST=claude-sonnet-5-5
# Модель для итогового аналитического вывода
LLM_MODEL_SMART=claude-opus-5-5

# --- Speech-to-Text: любой OpenAI-совместимый /v1/audio/transcriptions
# (если не задан — звонки считаются по CRM, но не прослушиваются)
# (OpenAI Whisper, faster-whisper-server у себя в контуре и т.п.)
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# Заголовок авторизации для скачивания записей у провайдера телефонии, если ссылки закрыты
# пример: Authorization: Bearer xxx
RECORDING_AUTH_HEADER=

# --- Прочее ---
DB_PATH=data/sales_analyst.sqlite
REPORTS_DIR=reports
# Сколько звонков максимум отправлять в STT+LLM за один прогон (контроль стоимости)
MAX_CALLS=40
# Звонки короче этого порога (сек) не анализируются: недозвоны, автоответчики
MIN_CALL_SECONDS=60
